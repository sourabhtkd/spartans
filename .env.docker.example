# Copy to .env.docker and edit:  cp .env.docker.example .env.docker
# Used by docker-compose.yml. Replace every CHANGE_ME.

# --- LLM keys passed to the app ---
GROQ_API_KEY=
FALLBACK_API_KEY=

# --- Redis (CodeForge semantic cache) ---
REDIS_PASSWORD=CHANGE_ME_redis

# --- Langfuse Cloud: create a project at https://cloud.langfuse.com -> Settings -> API Keys ---
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
# EU (default). US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
